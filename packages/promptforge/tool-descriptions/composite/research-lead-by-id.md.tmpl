short_description: |
  Return everything decision-relevant about one lead identified by its Leadbay
  UUID: qualification answers, web-research signals, firmographics, contacts
  and recent activity in one call. Use leadbay_research_lead_by_name_fuzzy
  when only the company name is known.
routing:
  triggers:
